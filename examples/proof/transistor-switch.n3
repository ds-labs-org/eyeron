    { :high :stateLabel "saturation / ON" . },
    { :high :collectorCurrentUa 4800 . },
    { :uafmt-4800 :uaValue 4800 . },
    { :uafmt-4800 :text "4.80 mA" . },
    { ("low input state                  : %s\n" "cutoff / OFF") string:format "low input state                  : cutoff / OFF\n" . },
