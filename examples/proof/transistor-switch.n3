{ :case :onStateIsLoadLimited true . }
  pe:rule 8;
  pe:binding
    [ pe:var "gain"; pe:value 43000 ],
    [ pe:var "ic"; pe:value 4800 ];
  pe:uses
    { :high :collectorCurrentUa 4800 . },
    { :high :collectorLoadLimitUa 4800 . },
    { :high :collectorGainLimitUa 43000 . },
    { 43000 math:greaterThan 4800 . }.

