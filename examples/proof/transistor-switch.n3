@prefix : <http://example.org/transistor-switch#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix string: <http://www.w3.org/2000/10/swap/string#> .

:low :baseCurrentUa 0 .
:low :collectorGainLimitUa 0 .
:low :collectorLoadLimitUa 0 .
:low :collectorCurrentUa 0 .
:low :loadVoltageMv 0 .
:low :collectorEmitterVoltageMv 5000 .
:low :cutoff true .
:low :saturation false .
:low :stateLabel "cutoff / OFF" .
:high :baseCurrentUa 430 .
:high :collectorGainLimitUa 43000 .
:high :collectorLoadLimitUa 4800 .
:high :cutoff false .
:low :summaryLine "Vin=0.00 V -> Ib=0.00 mA, Ic=0.00 mA, Vce=5.00 V, state=cutoff / OFF\n" .
:case :lowInputStaysInCutoff true .
:high :collectorCurrentUa 4800 .
:high :loadVoltageMv 4800 .
:high :collectorEmitterVoltageMv 200 .
:high :saturation true .
:high :stateLabel "saturation / ON" .
:case :onStateIsLoadLimited true .
:case :loadVoltageMatchesResistorDrop true .
:01-answer-1 log:outputString "# transistor-switch\n\n## Source files\n\n- [N3 rules](../transistor-switch.n3)\n\n## Answer\n" .
:01-answer-2 log:outputString "In this toy transistor-switch model, a low input leaves the transistor in cutoff (OFF) and a high input drives it into saturation (ON), so the load behaves like an on/off branch rather than a linear amplifier.\n" .
:01-answer-3 log:outputString "case                             : transistor-switch\n" .
:01-answer-4 log:outputString "low input state                  : cutoff / OFF\n" .
:01-answer-5 log:outputString "high input state                 : saturation / ON\n" .
:01-answer-6 log:outputString "on-state load current            : 4.80 mA\n\n" .
:case :highInputReachesSaturation true .
:case :switchesCleanly true .
:03-check-1 log:outputString "## Check\n" .
:03-check-2 log:outputString "low input stays in cutoff        : yes\n" .
:03-check-3 log:outputString "high input reaches saturation    : yes\n" .
:03-check-4 log:outputString "switching states differ          : yes\n" .
:03-check-5 log:outputString "on-state current is load-limited : yes\n" .
:03-check-6 log:outputString "load voltage matches resistor drop : yes\n" .
:high :summaryLine "Vin=5.00 V -> Ib=0.43 mA, Ic=4.80 mA, Vce=0.20 V, state=saturation / ON\n" .
:02-why-01 log:outputString "## Reason Why\n" .
:02-why-02 log:outputString "We model an NPN low-side switch with exact millivolt and microamp arithmetic. The base current comes from (Vin - Vbe,on)/Rb when the base-emitter junction is forward biased, and the collector current is the smaller of beta * Ib and the load-limited current (Vcc - Vce,sat)/Rl.\n" .
:02-why-03 log:outputString "supply voltage                   : 5.00 V\n" .
:02-why-04 log:outputString "base resistor                    : 10000 ohms\n" .
:02-why-05 log:outputString "load resistor                    : 1000 ohms\n" .
:02-why-06 log:outputString "transistor beta proxy            : 100\n" .
:02-why-07 log:outputString "low input                        : Vin=0.00 V -> Ib=0.00 mA, Ic=0.00 mA, Vce=5.00 V, state=cutoff / OFF\n" .
:02-why-08 log:outputString "high input                       : Vin=5.00 V -> Ib=0.43 mA, Ic=4.80 mA, Vce=0.20 V, state=saturation / ON\n" .
:02-why-09 log:outputString "high-input gain limit            : 43.00 mA\n" .
:02-why-10 log:outputString "high-input load limit            : 4.80 mA\n" .
:02-why-99 log:outputString "\n" .

{ :low :baseCurrentUa 0 . }
  pe:rule 1;
  pe:binding
    [ pe:var "state"; pe:value :low ],
    [ pe:var "vbe"; pe:value 700 ],
    [ pe:var "vcc"; pe:value 5000 ],
    [ pe:var "vin"; pe:value 0 ];
  pe:uses
    { :low list:in (:low :high) . },
    { :low :inputMv 0 . },
    { :case :vbeOnMv 700 . },
    { 0 math:notGreaterThan 700 . },
    { :case :supplyMv 5000 . }.

{ :low list:in (:low :high) . }
  pe:builtin list:in.

{ :low :inputMv 0 . }
  pe:fact "transistor-switch.n3".

{ :case :vbeOnMv 700 . }
  pe:fact "transistor-switch.n3".

{ 0 math:notGreaterThan 700 . }
  pe:builtin math:notGreaterThan.

{ :case :supplyMv 5000 . }
  pe:fact "transistor-switch.n3".

