{ :low :summaryLine "Vin=0.00 V -> Ib=0.00 mA, Ic=0.00 mA, Vce=5.00 V, state=cutoff / OFF\n" . }
  pe:rule 10;
  pe:binding
    [ pe:var "ib"; pe:value 0 ],
    [ pe:var "ibText"; pe:value "0.00 mA" ],
    [ pe:var "ic"; pe:value 0 ],
    [ pe:var "icText"; pe:value "0.00 mA" ],
    [ pe:var "label"; pe:value "cutoff / OFF" ],
    [ pe:var "mvVce"; pe:value :mvfmt-5000 ],
    [ pe:var "mvVin"; pe:value :mvfmt-0 ],
    [ pe:var "state"; pe:value :low ],
    [ pe:var "summary"; pe:value "Vin=0.00 V -> Ib=0.00 mA, Ic=0.00 mA, Vce=5.00 V, state=cutoff / OFF\n" ],
    [ pe:var "uaIb"; pe:value :uafmt-0 ],
    [ pe:var "uaIc"; pe:value :uafmt-0 ],
    [ pe:var "vce"; pe:value 5000 ],
    [ pe:var "vceText"; pe:value "5.00 V" ],
    [ pe:var "vin"; pe:value 0 ],
    [ pe:var "vinText"; pe:value "0.00 V" ];
  pe:uses
    { :low list:in (:low :high) . },
    { :low :inputMv 0 . },
    { :mvfmt-0 :mvValue 0 . },
    { :mvfmt-0 :text "0.00 V" . },
    { :low :baseCurrentUa 0 . },
    { :uafmt-0 :uaValue 0 . },
    { :uafmt-0 :text "0.00 mA" . },
    { :low :collectorCurrentUa 0 . },
    { :uafmt-0 :uaValue 0 . },
    { :uafmt-0 :text "0.00 mA" . },
    { :low :collectorEmitterVoltageMv 5000 . },
    { :mvfmt-5000 :mvValue 5000 . },
    { :mvfmt-5000 :text "5.00 V" . },
    { :low :stateLabel "cutoff / OFF" . },
    { ("Vin=%s -> Ib=%s, Ic=%s, Vce=%s, state=%s\n" "0.00 V" "0.00 mA" "0.00 mA" "5.00 V" "cutoff / OFF") string:format "Vin=0.00 V -> Ib=0.00 mA, Ic=0.00 mA, Vce=5.00 V, state=cutoff / OFF\n" . }.

