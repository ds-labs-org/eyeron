{ :02-why-02 log:outputString "We model an NPN low-side switch with exact millivolt and microamp arithmetic. The base current comes from (Vin - Vbe,on)/Rb when the base-emitter junction is forward biased, and the collector current is the smaller of beta * Ib and the load-limited current (Vcc - Vce,sat)/Rl.\n" . }
  pe:rule 12;
  pe:binding
    [ pe:var "beta"; pe:value 100 ],
    [ pe:var "betaLine"; pe:value "transistor beta proxy            : 100\n" ],
    [ pe:var "gainLimitText"; pe:value "43.00 mA" ],
    [ pe:var "gainLimitUa"; pe:value 43000 ],
    [ pe:var "gainLine"; pe:value "high-input gain limit            : 43.00 mA\n" ],
    [ pe:var "highLine"; pe:value "high input                       : Vin=5.00 V -> Ib=0.43 mA, Ic=4.80 mA, Vce=0.20 V, state=saturation / ON\n" ],
    [ pe:var "highSummary"; pe:value "Vin=5.00 V -> Ib=0.43 mA, Ic=4.80 mA, Vce=0.20 V, state=saturation / ON\n" ],
    [ pe:var "loadLimitText"; pe:value "4.80 mA" ],
    [ pe:var "loadLimitUa"; pe:value 4800 ],
    [ pe:var "loadLine"; pe:value "high-input load limit            : 4.80 mA\n" ],
    [ pe:var "lowLine"; pe:value "low input                        : Vin=0.00 V -> Ib=0.00 mA, Ic=0.00 mA, Vce=5.00 V, state=cutoff / OFF\n" ],
    [ pe:var "lowSummary"; pe:value "Vin=0.00 V -> Ib=0.00 mA, Ic=0.00 mA, Vce=5.00 V, state=cutoff / OFF\n" ],
    [ pe:var "mvSupply"; pe:value :mvfmt-5000 ],
    [ pe:var "rb"; pe:value 10000 ],
    [ pe:var "rbLine"; pe:value "base resistor                    : 10000 ohms\n" ],
    [ pe:var "rl"; pe:value 1000 ],
    [ pe:var "rlLine"; pe:value "load resistor                    : 1000 ohms\n" ],
    [ pe:var "supplyLine"; pe:value "supply voltage                   : 5.00 V\n" ],
    [ pe:var "supplyMv"; pe:value 5000 ],
    [ pe:var "supplyText"; pe:value "5.00 V" ],
    [ pe:var "uaGain"; pe:value :uafmt-43000 ],
    [ pe:var "uaLoad"; pe:value :uafmt-4800 ];
  pe:uses
    { :case :supplyMv 5000 . },
    { :mvfmt-5000 :mvValue 5000 . },
    { :mvfmt-5000 :text "5.00 V" . },
    { :case :baseResistanceOhms 10000 . },
