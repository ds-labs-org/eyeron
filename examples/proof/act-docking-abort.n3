:case :checkC12 :Passed .
:out log:outputString "ACT docking abort token — constructor-theory coverage case\n\n## Answer\nYES for the classical abort token.\nNO for universal cloning and unrestricted audit fan-out of the quantum seal.\n\n## Reason Why\nThe docking-abort token is treated as an abstract information variable carried by unlike classical media: lamp state, PLC register, radio frame, and audit display. Because those substrates are information media for the same variable, the token can be permuted locally, cloned locally, copied across media, measured into an output record, and embedded in serial and parallel task networks. By contrast, the quantum authenticity seal is treated as a superinformation medium, so cloning all of its states is impossible and unrestricted audit fan-out is blocked.\n\n## Check\nC1  OK - the abort lamp is a computation medium\nC2  OK - the abort lamp distinguishes the abort bit\nC3  OK - permutation of the abort bit is possible on the abort lamp\nC4  OK - local cloning of the abort bit is possible on the PLC register\nC5  OK - the abort bit can be copied from lamp to PLC\nC6  OK - the abort bit can be copied from PLC to radio frame\nC7  OK - the abort bit can be measured from radio frame into the audit display\nC8  OK - a serial network from lamp via PLC to audit display is possible\nC9  OK - a parallel network from PLC to radio frame and audit display is possible\nC10 OK - cloning all states of the quantum seal is an impossible task\nC11 OK - the quantum seal cannot be universally cloned\nC12 OK - the quantum seal cannot be used for unrestricted audit fan-out\n" .

{ :abortLamp a :ComputationMedium . }
  pe:rule 1;
  pe:binding
    [ pe:var "M"; pe:value :abortLamp ],
    [ pe:var "O"; pe:value :Red ],
    [ pe:var "V"; pe:value :AbortBit ],
    [ pe:var "Z"; pe:value :Green ];
  pe:uses
    { :abortLamp a :InformationMedium . },
    { :abortLamp :encodes :AbortBit . },
    { :abortLamp :zeroState :Green . },
    { :abortLamp :oneState :Red . }.

{ :abortLamp a :InformationMedium . }
  pe:fact "act-docking-abort.n3".

{ :abortLamp :encodes :AbortBit . }
  pe:fact "act-docking-abort.n3".

{ :abortLamp :zeroState :Green . }
  pe:fact "act-docking-abort.n3".

{ :abortLamp :oneState :Red . }
  pe:fact "act-docking-abort.n3".

{ :abortLamp :distinguishes :AbortBit . }
  pe:rule 1;
  pe:binding
    [ pe:var "M"; pe:value :abortLamp ],
    [ pe:var "O"; pe:value :Red ],
    [ pe:var "V"; pe:value :AbortBit ],
