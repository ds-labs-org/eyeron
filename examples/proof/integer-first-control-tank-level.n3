{ :trialLow :levelAt (0 12) . }
  pe:rule 1;
  pe:binding
    [ pe:var "level0"; pe:value 12 ],
    [ pe:var "trial"; pe:value :trialLow ];
  pe:uses
    { :trialLow a :ClosedLoopTrial . },
    { :trialLow :initialLevel 12 . }.

{ :trialLow a :ClosedLoopTrial . }
  pe:fact "integer-first-control-tank-level.n3".

{ :trialLow :initialLevel 12 . }
  pe:fact "integer-first-control-tank-level.n3".

{ :trialHigh :levelAt (0 28) . }
  pe:rule 1;
  pe:binding
    [ pe:var "level0"; pe:value 28 ],
    [ pe:var "trial"; pe:value :trialHigh ];
  pe:uses
    { :trialHigh a :ClosedLoopTrial . },
    { :trialHigh :initialLevel 28 . }.

{ :trialHigh a :ClosedLoopTrial . }
  pe:fact "integer-first-control-tank-level.n3".

{ :trialHigh :initialLevel 28 . }
  pe:fact "integer-first-control-tank-level.n3".

{ :trialNominal :levelAt (0 20) . }
  pe:rule 1;
  pe:binding
    [ pe:var "level0"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialNominal ];
  pe:uses
    { :trialNominal a :ClosedLoopTrial . },
    { :trialNominal :initialLevel 20 . }.

{ :trialNominal a :ClosedLoopTrial . }
  pe:fact "integer-first-control-tank-level.n3".

{ :trialNominal :initialLevel 20 . }
  pe:fact "integer-first-control-tank-level.n3".

{ :trialLow :valveAt (0 4) . }
  pe:rule 2;
  pe:binding
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "level"; pe:value 12 ],
    [ pe:var "trial"; pe:value :trialLow ];
  pe:uses
    { :trialLow :levelAt (0 12) . },
    { 12 math:lessThan 16 . }.

{ 12 math:lessThan 16 . }
  pe:builtin math:lessThan.

{ :trialLow :levelAt (1 14) . }
  pe:rule 7;
  pe:binding
    [ pe:var "inflowed"; pe:value 16 ],
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "k1"; pe:value 1 ],
    [ pe:var "level"; pe:value 12 ],
    [ pe:var "max"; pe:value 8 ],
    [ pe:var "nextLevel"; pe:value 14 ],
    [ pe:var "outflow"; pe:value 2 ],
    [ pe:var "trial"; pe:value :trialLow ],
    [ pe:var "valve"; pe:value 4 ];
  pe:uses
    { :controller :maxStep 8 . },
    { :controller :outflow 2 . },
    { :trialLow a :ClosedLoopTrial . },
    { :trialLow :levelAt (0 12) . },
    { :trialLow :valveAt (0 4) . },
    { 0 math:lessThan 8 . },
    { (0 1) math:sum 1 . },
    { (12 4) math:sum 16 . },
    { (16 2) math:difference 14 . }.

{ :controller :maxStep 8 . }
  pe:fact "integer-first-control-tank-level.n3".

{ :controller :outflow 2 . }
  pe:fact "integer-first-control-tank-level.n3".

{ 0 math:lessThan 8 . }
  pe:builtin math:lessThan.

{ (0 1) math:sum 1 . }
  pe:builtin math:sum.

{ (12 4) math:sum 16 . }
  pe:builtin math:sum.

{ (16 2) math:difference 14 . }
  pe:builtin math:difference.

{ :trialLow :errorAt (0 8) . }
  pe:rule 8;
  pe:binding
    [ pe:var "error"; pe:value 8 ],
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "level"; pe:value 12 ],
    [ pe:var "sp"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialLow ];
  pe:uses
    { :controller :setpoint 20 . },
    { :trialLow :levelAt (0 12) . },
    { 12 math:lessThan 20 . },
    { (20 12) math:difference 8 . }.

{ :controller :setpoint 20 . }
  pe:fact "integer-first-control-tank-level.n3".

{ 12 math:lessThan 20 . }
  pe:builtin math:lessThan.

{ (20 12) math:difference 8 . }
  pe:builtin math:difference.

{ :trialLow :sideAt (0 :below) . }
  pe:rule 8;
  pe:binding
    [ pe:var "error"; pe:value 8 ],
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "level"; pe:value 12 ],
    [ pe:var "sp"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialLow ];
  pe:uses
    { :controller :setpoint 20 . },
    { :trialLow :levelAt (0 12) . },
    { 12 math:lessThan 20 . },
    { (20 12) math:difference 8 . }.

{ :trialHigh :valveAt (0 0) . }
  pe:rule 6;
  pe:binding
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "level"; pe:value 28 ],
    [ pe:var "trial"; pe:value :trialHigh ];
  pe:uses
    { :trialHigh :levelAt (0 28) . },
    { 28 math:greaterThan 24 . }.

{ 28 math:greaterThan 24 . }
  pe:builtin math:greaterThan.

{ :trialHigh :levelAt (1 26) . }
  pe:rule 7;
  pe:binding
    [ pe:var "inflowed"; pe:value 28 ],
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "k1"; pe:value 1 ],
    [ pe:var "level"; pe:value 28 ],
    [ pe:var "max"; pe:value 8 ],
    [ pe:var "nextLevel"; pe:value 26 ],
    [ pe:var "outflow"; pe:value 2 ],
    [ pe:var "trial"; pe:value :trialHigh ],
    [ pe:var "valve"; pe:value 0 ];
  pe:uses
    { :controller :maxStep 8 . },
    { :controller :outflow 2 . },
    { :trialHigh a :ClosedLoopTrial . },
    { :trialHigh :levelAt (0 28) . },
    { :trialHigh :valveAt (0 0) . },
    { 0 math:lessThan 8 . },
    { (0 1) math:sum 1 . },
    { (28 0) math:sum 28 . },
    { (28 2) math:difference 26 . }.

{ (28 0) math:sum 28 . }
  pe:builtin math:sum.

{ (28 2) math:difference 26 . }
  pe:builtin math:difference.

{ :trialHigh :errorAt (0 8) . }
  pe:rule 9;
  pe:binding
    [ pe:var "error"; pe:value 8 ],
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "level"; pe:value 28 ],
    [ pe:var "sp"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialHigh ];
  pe:uses
    { :controller :setpoint 20 . },
    { :trialHigh :levelAt (0 28) . },
    { 28 math:notLessThan 20 . },
    { (28 20) math:difference 8 . }.

{ 28 math:notLessThan 20 . }
  pe:builtin math:notLessThan.

{ (28 20) math:difference 8 . }
  pe:builtin math:difference.

{ :trialHigh :sideAt (0 :aboveOrOn) . }
  pe:rule 9;
  pe:binding
    [ pe:var "error"; pe:value 8 ],
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "level"; pe:value 28 ],
    [ pe:var "sp"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialHigh ];
  pe:uses
    { :controller :setpoint 20 . },
    { :trialHigh :levelAt (0 28) . },
    { 28 math:notLessThan 20 . },
    { (28 20) math:difference 8 . }.

{ :trialNominal :valveAt (0 2) . }
  pe:rule 4;
  pe:binding
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "level"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialNominal ];
  pe:uses
    { :trialNominal :levelAt (0 20) . },
    { 20 math:notLessThan 19 . },
    { 20 math:notGreaterThan 21 . }.

{ 20 math:notLessThan 19 . }
  pe:builtin math:notLessThan.

{ 20 math:notGreaterThan 21 . }
  pe:builtin math:notGreaterThan.

{ :trialNominal :levelAt (1 20) . }
  pe:rule 7;
  pe:binding
    [ pe:var "inflowed"; pe:value 22 ],
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "k1"; pe:value 1 ],
    [ pe:var "level"; pe:value 20 ],
    [ pe:var "max"; pe:value 8 ],
    [ pe:var "nextLevel"; pe:value 20 ],
    [ pe:var "outflow"; pe:value 2 ],
    [ pe:var "trial"; pe:value :trialNominal ],
    [ pe:var "valve"; pe:value 2 ];
  pe:uses
    { :controller :maxStep 8 . },
    { :controller :outflow 2 . },
    { :trialNominal a :ClosedLoopTrial . },
    { :trialNominal :levelAt (0 20) . },
    { :trialNominal :valveAt (0 2) . },
    { 0 math:lessThan 8 . },
    { (0 1) math:sum 1 . },
    { (20 2) math:sum 22 . },
    { (22 2) math:difference 20 . }.

{ (20 2) math:sum 22 . }
  pe:builtin math:sum.

{ (22 2) math:difference 20 . }
  pe:builtin math:difference.

{ :trialNominal :errorAt (0 0) . }
  pe:rule 9;
  pe:binding
    [ pe:var "error"; pe:value 0 ],
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "level"; pe:value 20 ],
    [ pe:var "sp"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialNominal ];
  pe:uses
    { :controller :setpoint 20 . },
    { :trialNominal :levelAt (0 20) . },
    { 20 math:notLessThan 20 . },
    { (20 20) math:difference 0 . }.

{ 20 math:notLessThan 20 . }
  pe:builtin math:notLessThan.

{ (20 20) math:difference 0 . }
  pe:builtin math:difference.

{ :trialNominal :sideAt (0 :aboveOrOn) . }
  pe:rule 9;
  pe:binding
    [ pe:var "error"; pe:value 0 ],
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "level"; pe:value 20 ],
    [ pe:var "sp"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialNominal ];
  pe:uses
    { :controller :setpoint 20 . },
    { :trialNominal :levelAt (0 20) . },
    { 20 math:notLessThan 20 . },
    { (20 20) math:difference 0 . }.

{ :trialNominal :holdBandAt 0 . }
  pe:rule 11;
  pe:binding
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "k1"; pe:value 1 ],
    [ pe:var "level"; pe:value 20 ],
    [ pe:var "nextLevel"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialNominal ];
  pe:uses
    { :trialNominal :levelAt (0 20) . },
    { :trialNominal :valveAt (0 2) . },
    { 20 math:notLessThan 19 . },
    { 20 math:notGreaterThan 21 . },
    { (0 1) math:sum 1 . },
    { :trialNominal :levelAt (1 20) . },
    { 20 math:equalTo 20 . }.

{ 20 math:equalTo 20 . }
  pe:builtin math:equalTo.

{ :trialNominal :invariantStepAt 0 . }
  pe:rule 11;
  pe:binding
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "k1"; pe:value 1 ],
    [ pe:var "level"; pe:value 20 ],
    [ pe:var "nextLevel"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialNominal ];
  pe:uses
    { :trialNominal :levelAt (0 20) . },
    { :trialNominal :valveAt (0 2) . },
    { 20 math:notLessThan 19 . },
    { 20 math:notGreaterThan 21 . },
    { (0 1) math:sum 1 . },
    { :trialNominal :levelAt (1 20) . },
    { 20 math:equalTo 20 . }.

{ :trialLow :valveAt (1 4) . }
  pe:rule 2;
  pe:binding
    [ pe:var "k"; pe:value 1 ],
    [ pe:var "level"; pe:value 14 ],
    [ pe:var "trial"; pe:value :trialLow ];
  pe:uses
    { :trialLow :levelAt (1 14) . },
    { 14 math:lessThan 16 . }.

{ 14 math:lessThan 16 . }
  pe:builtin math:lessThan.

{ :trialLow :levelAt (2 16) . }
  pe:rule 7;
  pe:binding
    [ pe:var "inflowed"; pe:value 18 ],
    [ pe:var "k"; pe:value 1 ],
    [ pe:var "k1"; pe:value 2 ],
    [ pe:var "level"; pe:value 14 ],
    [ pe:var "max"; pe:value 8 ],
    [ pe:var "nextLevel"; pe:value 16 ],
    [ pe:var "outflow"; pe:value 2 ],
    [ pe:var "trial"; pe:value :trialLow ],
    [ pe:var "valve"; pe:value 4 ];
  pe:uses
    { :controller :maxStep 8 . },
    { :controller :outflow 2 . },
    { :trialLow a :ClosedLoopTrial . },
    { :trialLow :levelAt (1 14) . },
    { :trialLow :valveAt (1 4) . },
    { 1 math:lessThan 8 . },
    { (1 1) math:sum 2 . },
    { (14 4) math:sum 18 . },
    { (18 2) math:difference 16 . }.

{ 1 math:lessThan 8 . }
  pe:builtin math:lessThan.

{ (1 1) math:sum 2 . }
  pe:builtin math:sum.

{ (14 4) math:sum 18 . }
  pe:builtin math:sum.

{ (18 2) math:difference 16 . }
  pe:builtin math:difference.

{ :trialLow :errorAt (1 6) . }
  pe:rule 8;
  pe:binding
    [ pe:var "error"; pe:value 6 ],
    [ pe:var "k"; pe:value 1 ],
    [ pe:var "level"; pe:value 14 ],
    [ pe:var "sp"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialLow ];
  pe:uses
    { :controller :setpoint 20 . },
    { :trialLow :levelAt (1 14) . },
    { 14 math:lessThan 20 . },
    { (20 14) math:difference 6 . }.

{ 14 math:lessThan 20 . }
  pe:builtin math:lessThan.

{ (20 14) math:difference 6 . }
  pe:builtin math:difference.

{ :trialLow :sideAt (1 :below) . }
  pe:rule 8;
  pe:binding
    [ pe:var "error"; pe:value 6 ],
    [ pe:var "k"; pe:value 1 ],
    [ pe:var "level"; pe:value 14 ],
    [ pe:var "sp"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialLow ];
  pe:uses
    { :controller :setpoint 20 . },
    { :trialLow :levelAt (1 14) . },
    { 14 math:lessThan 20 . },
    { (20 14) math:difference 6 . }.

{ :trialLow :strictImprovementAt 0 . }
  pe:rule 10;
  pe:binding
    [ pe:var "error"; pe:value 8 ],
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "k1"; pe:value 1 ],
    [ pe:var "nextError"; pe:value 6 ],
    [ pe:var "trial"; pe:value :trialLow ];
  pe:uses
    { :trialLow :errorAt (0 8) . },
    { 8 math:greaterThan 1 . },
    { (0 1) math:sum 1 . },
    { :trialLow :errorAt (1 6) . },
    { 6 math:lessThan 8 . }.

{ 8 math:greaterThan 1 . }
  pe:builtin math:greaterThan.

{ 6 math:lessThan 8 . }
  pe:builtin math:lessThan.

{ :trialHigh :valveAt (1 0) . }
  pe:rule 6;
  pe:binding
    [ pe:var "k"; pe:value 1 ],
    [ pe:var "level"; pe:value 26 ],
    [ pe:var "trial"; pe:value :trialHigh ];
  pe:uses
    { :trialHigh :levelAt (1 26) . },
    { 26 math:greaterThan 24 . }.

{ 26 math:greaterThan 24 . }
  pe:builtin math:greaterThan.

{ :trialHigh :levelAt (2 24) . }
  pe:rule 7;
  pe:binding
    [ pe:var "inflowed"; pe:value 26 ],
    [ pe:var "k"; pe:value 1 ],
    [ pe:var "k1"; pe:value 2 ],
    [ pe:var "level"; pe:value 26 ],
    [ pe:var "max"; pe:value 8 ],
    [ pe:var "nextLevel"; pe:value 24 ],
    [ pe:var "outflow"; pe:value 2 ],
    [ pe:var "trial"; pe:value :trialHigh ],
    [ pe:var "valve"; pe:value 0 ];
  pe:uses
    { :controller :maxStep 8 . },
    { :controller :outflow 2 . },
    { :trialHigh a :ClosedLoopTrial . },
    { :trialHigh :levelAt (1 26) . },
    { :trialHigh :valveAt (1 0) . },
    { 1 math:lessThan 8 . },
    { (1 1) math:sum 2 . },
    { (26 0) math:sum 26 . },
    { (26 2) math:difference 24 . }.

{ (26 0) math:sum 26 . }
  pe:builtin math:sum.

{ (26 2) math:difference 24 . }
  pe:builtin math:difference.

{ :trialHigh :errorAt (1 6) . }
  pe:rule 9;
  pe:binding
    [ pe:var "error"; pe:value 6 ],
    [ pe:var "k"; pe:value 1 ],
    [ pe:var "level"; pe:value 26 ],
    [ pe:var "sp"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialHigh ];
  pe:uses
    { :controller :setpoint 20 . },
    { :trialHigh :levelAt (1 26) . },
    { 26 math:notLessThan 20 . },
    { (26 20) math:difference 6 . }.

{ 26 math:notLessThan 20 . }
  pe:builtin math:notLessThan.

{ (26 20) math:difference 6 . }
  pe:builtin math:difference.

{ :trialHigh :sideAt (1 :aboveOrOn) . }
  pe:rule 9;
  pe:binding
    [ pe:var "error"; pe:value 6 ],
    [ pe:var "k"; pe:value 1 ],
    [ pe:var "level"; pe:value 26 ],
    [ pe:var "sp"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialHigh ];
  pe:uses
    { :controller :setpoint 20 . },
    { :trialHigh :levelAt (1 26) . },
    { 26 math:notLessThan 20 . },
    { (26 20) math:difference 6 . }.

{ :trialHigh :strictImprovementAt 0 . }
  pe:rule 10;
  pe:binding
    [ pe:var "error"; pe:value 8 ],
    [ pe:var "k"; pe:value 0 ],
    [ pe:var "k1"; pe:value 1 ],
    [ pe:var "nextError"; pe:value 6 ],
    [ pe:var "trial"; pe:value :trialHigh ];
  pe:uses
    { :trialHigh :errorAt (0 8) . },
    { 8 math:greaterThan 1 . },
    { (0 1) math:sum 1 . },
    { :trialHigh :errorAt (1 6) . },
    { 6 math:lessThan 8 . }.

{ :trialNominal :valveAt (1 2) . }
  pe:rule 4;
  pe:binding
    [ pe:var "k"; pe:value 1 ],
    [ pe:var "level"; pe:value 20 ],
    [ pe:var "trial"; pe:value :trialNominal ];
  pe:uses
