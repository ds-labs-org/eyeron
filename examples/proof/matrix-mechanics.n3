:XX :a12 0 .
:XX :a21 0 .
:XX :a22 1 .
:s05 log:outputString "X = [[0,1],[1,0]]\n" .
:H :spectrumOk "yes" .
:C :a11 0 .
:C :a12 -1 .
:C :a21 1 .
:C :a22 0 .
:s06 log:outputString "HX = [[0,1],[2,0]]\n" .
:s07 log:outputString "XH = [[0,2],[1,0]]\n" .
:X :involution "yes" .
:s10 log:outputString "trace/determinant match energy levels: yes\n" .
:s08 log:outputString "[H,X] = [[0,-1],[1,0]]\n" .
:C :nonzero "yes" .
:model :ok "yes" .
:model :answer "In this toy matrix-mechanics model, the Hamiltonian has two discrete energy levels and does not commute with a second observable." .
:s11 log:outputString "X^2 = I : yes\n" .
:s12 log:outputString "[H,X] != 0 : yes\n" .
:s09 log:outputString "\n## Check\n" .
:s01 log:outputString "# matrix-mechanics\n\n## Source files\n\n- [N3 rules](../matrix-mechanics.n3)\n\n## Answer\n" .
:s02 log:outputString "In this toy matrix-mechanics model, the Hamiltonian has two discrete energy levels and does not commute with a second observable." .
:s03 log:outputString "\n\n## Reason Why\n" .

{ :H :trace 3 . }
  pe:rule 1;
  pe:binding
    [ pe:var "h11"; pe:value 1 ],
    [ pe:var "h22"; pe:value 2 ],
    [ pe:var "tr"; pe:value 3 ];
  pe:uses
    { :H :a11 1 . },
    { :H :a22 2 . },
    { (1 2) math:sum 3 . }.

{ :H :a11 1 . }
  pe:fact "matrix-mechanics.n3".

{ :H :a22 2 . }
  pe:fact "matrix-mechanics.n3".

{ (1 2) math:sum 3 . }
  pe:builtin math:sum.

{ :H :det 2 . }
  pe:rule 2;
