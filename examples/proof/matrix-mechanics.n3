    [ pe:var "det"; pe:value 2 ],
    [ pe:var "h11"; pe:value 1 ],
    [ pe:var "h12"; pe:value 0 ],
    [ pe:var "h21"; pe:value 0 ],
    [ pe:var "h22"; pe:value 2 ],
    [ pe:var "p1"; pe:value 2 ],
    [ pe:var "p2"; pe:value 0 ];
  pe:uses
    { :H :a11 1 . },
    { :H :a12 0 . },
    { :H :a21 0 . },
    { :H :a22 2 . },
    { (1 2) math:product 2 . },
    { (0 0) math:product 0 . },
    { (2 0) math:difference 2 . }.

