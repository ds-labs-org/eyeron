@prefix : <https://example.org/n3-speaks#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix id: <https://example.org/id/> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

id:alice foaf:name "Alice" .
id:alice foaf:knows id:bob .
id:bob foaf:name "Bob" .
id:bob foaf:knows id:carol .
id:carol foaf:name "Carol" .
id:carol foaf:knows id:dave .
id:dave foaf:name "Dave" .
id:alice :knowsPlus id:bob .
id:bob :knowsPlus id:carol .
id:alice :knowsPlus id:carol .
id:carol :knowsPlus id:dave .
id:bob :knowsPlus id:dave .
id:alice :knowsPlus id:dave .

{ id:alice foaf:name "Alice" . }
  pe:rule 1;
  pe:binding
    [ pe:var "Doc"; pe:value <https://alice.example/profile.n3> ],
    [ pe:var "F"; pe:value {
        id:alice foaf:name "Alice" .
        id:alice foaf:knows id:bob .
    } ],
    [ pe:var "O"; pe:value "Alice" ],
    [ pe:var "P"; pe:value foaf:name ],
    [ pe:var "S"; pe:value id:alice ];
  pe:uses
    { :policy :trusts <https://alice.example/profile.n3> . },
    {
        <https://alice.example/profile.n3> :says {
            id:alice foaf:name "Alice" .
            id:alice foaf:knows id:bob .
        } .
    },
    {
        {
            id:alice foaf:name "Alice" .
            id:alice foaf:knows id:bob .
        } log:includes {
            id:alice foaf:name "Alice" .
        } .
    }.

{ :policy :trusts <https://alice.example/profile.n3> . }
  pe:fact "n3-speaks-for-itself.n3".

{
  <https://alice.example/profile.n3> :says {
      id:alice foaf:name "Alice" .
      id:alice foaf:knows id:bob .
  } .
}
  pe:fact "n3-speaks-for-itself.n3".

{
  {
      id:alice foaf:name "Alice" .
      id:alice foaf:knows id:bob .
  } log:includes {
      id:alice foaf:name "Alice" .
  } .
}
  pe:builtin log:includes.

