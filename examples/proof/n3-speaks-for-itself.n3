{ id:alice :knowsPlus id:bob . }
  pe:rule 2;
  pe:binding
    [ pe:var "A"; pe:value id:alice ],
    [ pe:var "B"; pe:value id:bob ];
  pe:uses { id:alice foaf:knows id:bob . }.

