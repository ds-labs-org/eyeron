{ :relayRegister :can :LocalPermutation . }
  pe:rule 1;
  pe:binding
    [ pe:var "M"; pe:value :relayRegister ],
    [ pe:var "O"; pe:value :HighVoltage ],
    [ pe:var "V"; pe:value :AlarmBit ],
