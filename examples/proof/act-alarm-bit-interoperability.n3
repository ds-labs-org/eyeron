{ :quantumToken :cannot :UniversalClone . }
  pe:rule 3;
  pe:binding
    [ pe:var "M"; pe:value :quantumToken ],
    [ pe:var "V"; pe:value :PolarizationVariable ];
  pe:uses
    { :quantumToken a :SuperinformationMedium . },
