    { :sqrt2 :bounds (1 1.0 1.5) . },
    { 1.0 math:notLessThan 1.0 . },
    { 1.5 math:notGreaterThan 2.0 . }.

{ 1.0 math:notLessThan 1.0 . }
  pe:builtin math:notLessThan.

{ 1.5 math:notGreaterThan 2.0 . }
