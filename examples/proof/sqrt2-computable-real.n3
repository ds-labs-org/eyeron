{ :bisectSqrt2 :interval (1 1.0 1.5) . }
  pe:rule 2;
  pe:binding
    [ pe:var "L"; pe:value 1.0 ],
    [ pe:var "M"; pe:value 1.5 ],
    [ pe:var "M2"; pe:value 2.25 ],
    [ pe:var "N"; pe:value 12 ],
    [ pe:var "U"; pe:value 2.0 ],
    [ pe:var "n"; pe:value 0 ],
    [ pe:var "n1"; pe:value 1 ],
    [ pe:var "s"; pe:value "3"^^xsd:decimal ];
  pe:uses
    { :bisectSqrt2 :interval (0 1.0 2.0) . },
    { :bisectSqrt2 :maxN 12 . },
    { 0 math:lessThan 12 . },
    { (0 1) math:sum 1 . },
    { (1.0 2.0) math:sum "3"^^xsd:decimal . },
    { ("3"^^xsd:decimal 2) math:quotient 1.5 . },
    { (1.5 1.5) math:product 2.25 . },
    { 2.25 math:notLessThan 2 . }.

{ :bisectSqrt2 :interval (0 1.0 2.0) . }
  pe:fact "sqrt2-computable-real.n3".

{ :bisectSqrt2 :maxN 12 . }
  pe:fact "sqrt2-computable-real.n3".

{ 0 math:lessThan 12 . }
  pe:builtin math:lessThan.

{ (0 1) math:sum 1 . }
  pe:builtin math:sum.

{ (1.0 2.0) math:sum "3"^^xsd:decimal . }
  pe:builtin math:sum.

{ ("3"^^xsd:decimal 2) math:quotient 1.5 . }
  pe:builtin math:quotient.

{ (1.5 1.5) math:product 2.25 . }
  pe:builtin math:product.

{ 2.25 math:notLessThan 2 . }
  pe:builtin math:notLessThan.

{ :bisectSqrt2 :width (0 "1"^^xsd:decimal) . }
  pe:rule 3;
  pe:binding
    [ pe:var "L"; pe:value 1.0 ],
    [ pe:var "U"; pe:value 2.0 ],
    [ pe:var "W"; pe:value "1"^^xsd:decimal ],
    [ pe:var "n"; pe:value 0 ];
  pe:uses
    { :bisectSqrt2 :interval (0 1.0 2.0) . },
    { (2.0 1.0) math:difference "1"^^xsd:decimal . }.

{ (2.0 1.0) math:difference "1"^^xsd:decimal . }
  pe:builtin math:difference.

{ :bisectSqrt2 :epsilon (0 "1"^^xsd:decimal) . }
  pe:rule 4;
  pe:binding
    [ pe:var "L"; pe:value 1.0 ],
    [ pe:var "U"; pe:value 2.0 ],
    [ pe:var "eps"; pe:value "1"^^xsd:decimal ],
    [ pe:var "n"; pe:value 0 ],
    [ pe:var "pow2"; pe:value 1 ];
  pe:uses
    { :bisectSqrt2 :interval (0 1.0 2.0) . },
    { (2 0) math:exponentiation 1 . },
    { (1.0 1) math:quotient "1"^^xsd:decimal . }.

{ (2 0) math:exponentiation 1 . }
  pe:builtin math:exponentiation.

{ (1.0 1) math:quotient "1"^^xsd:decimal . }
  pe:builtin math:quotient.

{ :sqrt2 :bounds (0 1.0 2.0) . }
  pe:rule 6;
  pe:binding
    [ pe:var "L"; pe:value 1.0 ],
    [ pe:var "U"; pe:value 2.0 ],
    [ pe:var "n"; pe:value 0 ];
  pe:uses { :bisectSqrt2 :interval (0 1.0 2.0) . }.

{ :bisectSqrt2 :interval (2 1.25 1.5) . }
  pe:rule 1;
  pe:binding
    [ pe:var "L"; pe:value 1.0 ],
    [ pe:var "M"; pe:value 1.25 ],
    [ pe:var "M2"; pe:value 1.5625 ],
    [ pe:var "N"; pe:value 12 ],
    [ pe:var "U"; pe:value 1.5 ],
    [ pe:var "n"; pe:value 1 ],
    [ pe:var "n1"; pe:value 2 ],
    [ pe:var "s"; pe:value 2.5 ];
  pe:uses
    { :bisectSqrt2 :interval (1 1.0 1.5) . },
    { :bisectSqrt2 :maxN 12 . },
    { 1 math:lessThan 12 . },
    { (1 1) math:sum 2 . },
    { (1.0 1.5) math:sum 2.5 . },
    { (2.5 2) math:quotient 1.25 . },
    { (1.25 1.25) math:product 1.5625 . },
    { 1.5625 math:lessThan 2 . }.

{ 1 math:lessThan 12 . }
  pe:builtin math:lessThan.

{ (1 1) math:sum 2 . }
  pe:builtin math:sum.

{ (1.0 1.5) math:sum 2.5 . }
  pe:builtin math:sum.

{ (2.5 2) math:quotient 1.25 . }
  pe:builtin math:quotient.

{ (1.25 1.25) math:product 1.5625 . }
