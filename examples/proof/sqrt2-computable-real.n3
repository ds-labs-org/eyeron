{ :sqrt2 :nested (1 true) . }
  pe:rule 9;
  pe:binding
    [ pe:var "L"; pe:value 1.0 ],
    [ pe:var "L1"; pe:value 1.0 ],
    [ pe:var "U"; pe:value 2.0 ],
