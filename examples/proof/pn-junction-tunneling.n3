{ :case :peakMatchesFullOverlap true . }
  pe:rule 12;
  pe:binding
    [ pe:var "nCount"; pe:value 4 ],
    [ pe:var "nLevels"; pe:value (1 2 3 4) ],
    [ pe:var "peakCurrent"; pe:value 4 ];
  pe:uses
