    { :case :nFilledLevels (1 2 3 4) . },
    { (1 2 3 4) list:length 4 . },
    { 4 math:equalTo 4 . }.

{ :case :nFilledLevels (1 2 3 4) . }
  pe:fact "pn-junction-tunneling.n3".

{ (1 2 3 4) list:length 4 . }
