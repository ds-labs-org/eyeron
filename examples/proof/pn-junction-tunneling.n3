{ ("peak bias                     : %s\n" 2) string:format "peak bias                     : 2\n" . }
  pe:builtin string:format.

{ ("peak current proxy            : %s\n" 4) string:format "peak current proxy            : 4\n" . }
  pe:builtin string:format.

{ :01-answer-2 log:outputString "In this toy PN-junction tunneling model, heavy doping narrows the depletion region enough for a tunneling window that rises to a peak and then falls, producing a negative-differential region.\n" . }
  pe:rule 13;
  pe:binding
    [ pe:var "peakBias"; pe:value 2 ],
    [ pe:var "peakBiasLine"; pe:value "peak bias                     : 2\n" ],
    [ pe:var "peakCurrent"; pe:value 4 ],
