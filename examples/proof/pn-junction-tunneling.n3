    { :case :peakBias 2 . },
    { :case :peakCurrent 4 . },
    { :case :negativeDifferentialRegion true . },
    { ("peak bias                     : %s\n" 2) string:format "peak bias                     : 2\n" . },
    { ("peak current proxy            : %s\n" 4) string:format "peak current proxy            : 4\n" . }.

