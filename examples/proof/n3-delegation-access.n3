{ :policy :trusts <https://hr.example/policy.n3> . }
  pe:rule 1;
  pe:binding
    [ pe:var "Doc"; pe:value <https://root.example/policy.n3> ],
    [ pe:var "F"; pe:value {
        :policy :delegatesTo <https://hr.example/policy.n3> .
        :policy :delegatesTo <https://team.example/members.n3> .
    } ],
    [ pe:var "Other"; pe:value <https://hr.example/policy.n3> ];
  pe:uses
    { :policy :trusts <https://root.example/policy.n3> . },
    {
        <https://root.example/policy.n3> :says {
            :policy :delegatesTo <https://hr.example/policy.n3> .
            :policy :delegatesTo <https://team.example/members.n3> .
        } .
    },
    {
        {
            :policy :delegatesTo <https://hr.example/policy.n3> .
            :policy :delegatesTo <https://team.example/members.n3> .
        } log:includes {
            :policy :delegatesTo <https://hr.example/policy.n3> .
        } .
    }.

