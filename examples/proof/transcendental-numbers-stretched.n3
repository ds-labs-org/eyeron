{ :e_plus_1 :kind :Transcendental . }
  pe:rule 5;
  pe:binding
    [ pe:var "A"; pe:value :one ],
    [ pe:var "T"; pe:value :e ],
    [ pe:var "X"; pe:value :e_plus_1 ];
  pe:uses
    { :e_plus_1 :plusLeft :e . },
    { :e_plus_1 :plusRight :one . },
    { :e :kind :Transcendental . },
    { :one :kind :Algebraic . }.

{ :e_plus_1 :plusLeft :e . }
  pe:fact "transcendental-numbers-stretched.n3".

{ :e_plus_1 :plusRight :one . }
  pe:fact "transcendental-numbers-stretched.n3".

