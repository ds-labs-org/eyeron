@prefix : <https://example.org/insight/harborsmr/> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix pe: <https://eyereasoner.github.io/pe#> .
@prefix string: <http://www.w3.org/2000/10/swap/string#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:case :checkC7 :Passed .
:case :checkC1 :Passed .
:case :checkC2 :Passed .
:case :checkC3 :Passed .
:case :checkC6 :Passed .
:case :checkC4 :Passed .
:case :checkC9 :Passed .
:case :checkC5 :Passed .
:case :checkC10 :Passed .
:case :checkC8 :Passed .
:case :decision :Permit .
:decision :target <https://example.org/insight/harborsmr> .
:decision :outcome "Allowed" .
:out log:outputString "HarborSMR — bounded flexible-export insight for port electrolysis\n\n## Answer\nPERMIT\nThe port hydrogen hub may use the SMR insight to run PEM electrolyzer train 2 at 16 MW from 14:00 to 18:00.\n\n## Reason Why\nThe operator shares only a narrow, expiring insight that a temporary 18 MW flexible-export window is available. The request is for electrolysis dispatch only, the requested 16 MW fits inside the permitted window, safety margins are above threshold, no outage blocks the window, and the policy forbids redistribution for market resale. Raw reactor telemetry stays local.\n\n## Check\nC1  OK - reserve margin exceeds the dispatch threshold\nC2  OK - cooling margin exceeds the dispatch threshold\nC3  OK - no planned outage blocks the window\nC4  OK - requested MW fits within the export window\nC5  OK - serialized insight omits sensitive telemetry terms\nC6  OK - aggregate excludes core temperature, rod position, neutron flux, and operator IDs\nC7  OK - policy allows use for electrolysis dispatch before expiry\nC8  OK - policy prohibits redistribution for market resale\nC9  OK - scope is explicit: device, event, start, and expiry\nC10 OK - dispatch plan matches the requested load and power\n" .

{ :case :checkC7 :Passed . }
  pe:rule 7;
  pe:binding
    [ pe:var "authAt"; pe:value "2026-06-18T13:10:00+00:00"^^xsd:dateTime ],
    [ pe:var "expiresAt"; pe:value "2026-06-18T18:00:00+00:00"^^xsd:dateTime ];
  pe:uses
    { :policy odrl:permission _:b1 . },
    { _:b1 odrl:action odrl:use . },
    { _:b1 odrl:target <https://example.org/insight/harborsmr> . },
    { _:b1 odrl:constraint _:b2 . },
    { _:b2 odrl:leftOperand odrl:purpose . },
    { _:b2 odrl:operator odrl:eq . },
    { _:b2 odrl:rightOperand "electrolysis_dispatch" . },
    { :case :hubAuthAt "2026-06-18T13:10:00+00:00"^^xsd:dateTime . },
    { :flexInsight :expiresAt "2026-06-18T18:00:00+00:00"^^xsd:dateTime . },
    { "2026-06-18T13:10:00+00:00"^^xsd:dateTime math:notGreaterThan "2026-06-18T18:00:00+00:00"^^xsd:dateTime . }.

{ :policy odrl:permission _:b1 . }
  pe:fact "harborsmr.n3".

{ _:b1 odrl:action odrl:use . }
  pe:fact "harborsmr.n3".

{ _:b1 odrl:target <https://example.org/insight/harborsmr> . }
  pe:fact "harborsmr.n3".

{ _:b1 odrl:constraint _:b2 . }
  pe:fact "harborsmr.n3".

{ _:b2 odrl:leftOperand odrl:purpose . }
  pe:fact "harborsmr.n3".

{ _:b2 odrl:operator odrl:eq . }
  pe:fact "harborsmr.n3".

{ _:b2 odrl:rightOperand "electrolysis_dispatch" . }
  pe:fact "harborsmr.n3".

{ :case :hubAuthAt "2026-06-18T13:10:00+00:00"^^xsd:dateTime . }
  pe:fact "harborsmr.n3".

{ :flexInsight :expiresAt "2026-06-18T18:00:00+00:00"^^xsd:dateTime . }
  pe:fact "harborsmr.n3".

{ "2026-06-18T13:10:00+00:00"^^xsd:dateTime math:notGreaterThan "2026-06-18T18:00:00+00:00"^^xsd:dateTime . }
  pe:builtin math:notGreaterThan.

{ :case :checkC1 :Passed . }
  pe:rule 1;
  pe:binding [ pe:var "mw"; pe:value 24 ];
  pe:uses
    { :secureAggregate :reserveMarginMW 24 . },
    { 24 math:greaterThan 19 . }.

{ :secureAggregate :reserveMarginMW 24 . }
  pe:fact "harborsmr.n3".

{ 24 math:greaterThan 19 . }
  pe:builtin math:greaterThan.

{ :case :checkC2 :Passed . }
  pe:rule 2;
  pe:binding [ pe:var "pct"; pe:value 18 ];
  pe:uses
    { :secureAggregate :coolingMarginPct 18 . },
    { 18 math:greaterThan 14 . }.

{ :secureAggregate :coolingMarginPct 18 . }
  pe:fact "harborsmr.n3".

{ 18 math:greaterThan 14 . }
  pe:builtin math:greaterThan.

{ :case :checkC3 :Passed . }
  pe:rule 3;
  pe:uses { :secureAggregate :plannedOutage false . }.

{ :secureAggregate :plannedOutage false . }
  pe:fact "harborsmr.n3".

{ :case :checkC6 :Passed . }
  pe:rule 6;
  pe:uses
    { :secureAggregate :containsCoreTemperature false . },
    { :secureAggregate :containsRodPosition false . },
    { :secureAggregate :containsNeutronFlux false . },
    { :secureAggregate :containsOperatorBadgeIds false . }.

{ :secureAggregate :containsCoreTemperature false . }
  pe:fact "harborsmr.n3".

{ :secureAggregate :containsRodPosition false . }
  pe:fact "harborsmr.n3".

{ :secureAggregate :containsNeutronFlux false . }
  pe:fact "harborsmr.n3".

{ :secureAggregate :containsOperatorBadgeIds false . }
  pe:fact "harborsmr.n3".

{ :case :checkC4 :Passed . }
  pe:rule 4;
  pe:binding
    [ pe:var "cap"; pe:value 18 ],
    [ pe:var "req"; pe:value 16 ];
  pe:uses
    { :electrolyzerRequest :requestedMW 16 . },
    { :flexInsight :exportMW 18 . },
    { 16 math:notGreaterThan 18 . }.

{ :electrolyzerRequest :requestedMW 16 . }
  pe:fact "harborsmr.n3".

{ :flexInsight :exportMW 18 . }
  pe:fact "harborsmr.n3".

{ 16 math:notGreaterThan 18 . }
  pe:builtin math:notGreaterThan.

{ :case :checkC9 :Passed . }
  pe:rule 9;
  pe:binding
    [ pe:var "device"; pe:value "port-hydrogen-hub" ],
    [ pe:var "end"; pe:value "2026-06-18T18:00:00+00:00"^^xsd:dateTime ],
    [ pe:var "event"; pe:value "day_ahead_balancing" ],
    [ pe:var "start"; pe:value "2026-06-18T14:00:00+00:00"^^xsd:dateTime ];
  pe:uses
    { :flexInsight :scopeDevice "port-hydrogen-hub" . },
    { :flexInsight :scopeEvent "day_ahead_balancing" . },
    { :flexInsight :windowStart "2026-06-18T14:00:00+00:00"^^xsd:dateTime . },
    { :flexInsight :expiresAt "2026-06-18T18:00:00+00:00"^^xsd:dateTime . }.

{ :flexInsight :scopeDevice "port-hydrogen-hub" . }
  pe:fact "harborsmr.n3".

{ :flexInsight :scopeEvent "day_ahead_balancing" . }
  pe:fact "harborsmr.n3".

{ :flexInsight :windowStart "2026-06-18T14:00:00+00:00"^^xsd:dateTime . }
  pe:fact "harborsmr.n3".

{ :case :checkC5 :Passed . }
  pe:rule 5;
  pe:binding [ pe:var "s"; pe:value "{\"createdat\":\"2026-06-18t13:00:00+00:00\",\"expiresat\":\"2026-06-18t18:00:00+00:00\",\"exportmw\":18,\"id\":\"https://example.org/insight/harborsmr\",\"metric\":\"temporary_flexible_export_window\",\"scopedevice\":\"port-hydrogen-hub\",\"scopeevent\":\"day_ahead_balancing\",\"targetload\":\"pem_electrolyzer_train_2\",\"type\":\"ins:insight\"}" ];
  pe:uses
    { :flexInsight :serializedLowercase "{\"createdat\":\"2026-06-18t13:00:00+00:00\",\"expiresat\":\"2026-06-18t18:00:00+00:00\",\"exportmw\":18,\"id\":\"https://example.org/insight/harborsmr\",\"metric\":\"temporary_flexible_export_window\",\"scopedevice\":\"port-hydrogen-hub\",\"scopeevent\":\"day_ahead_balancing\",\"targetload\":\"pem_electrolyzer_train_2\",\"type\":\"ins:insight\"}" . },
    { "{\"createdat\":\"2026-06-18t13:00:00+00:00\",\"expiresat\":\"2026-06-18t18:00:00+00:00\",\"exportmw\":18,\"id\":\"https://example.org/insight/harborsmr\",\"metric\":\"temporary_flexible_export_window\",\"scopedevice\":\"port-hydrogen-hub\",\"scopeevent\":\"day_ahead_balancing\",\"targetload\":\"pem_electrolyzer_train_2\",\"type\":\"ins:insight\"}" string:notMatches "coretemp|rodposition|neutronflux|operatorbadge" . }.

{ :flexInsight :serializedLowercase "{\"createdat\":\"2026-06-18t13:00:00+00:00\",\"expiresat\":\"2026-06-18t18:00:00+00:00\",\"exportmw\":18,\"id\":\"https://example.org/insight/harborsmr\",\"metric\":\"temporary_flexible_export_window\",\"scopedevice\":\"port-hydrogen-hub\",\"scopeevent\":\"day_ahead_balancing\",\"targetload\":\"pem_electrolyzer_train_2\",\"type\":\"ins:insight\"}" . }
  pe:fact "harborsmr.n3".

{ "{\"createdat\":\"2026-06-18t13:00:00+00:00\",\"expiresat\":\"2026-06-18t18:00:00+00:00\",\"exportmw\":18,\"id\":\"https://example.org/insight/harborsmr\",\"metric\":\"temporary_flexible_export_window\",\"scopedevice\":\"port-hydrogen-hub\",\"scopeevent\":\"day_ahead_balancing\",\"targetload\":\"pem_electrolyzer_train_2\",\"type\":\"ins:insight\"}" string:notMatches "coretemp|rodposition|neutronflux|operatorbadge" . }
  pe:builtin string:notMatches.

{ :case :checkC10 :Passed . }
  pe:rule 10;
  pe:binding
    [ pe:var "load"; pe:value "PEM_electrolyzer_train_2" ],
    [ pe:var "mw"; pe:value 16 ],
    [ pe:var "req"; pe:value 16 ];
  pe:uses
    { :dispatchPlan :dispatchMW 16 . },
    { :electrolyzerRequest :requestedMW 16 . },
    { :dispatchPlan :forLoad "PEM_electrolyzer_train_2" . },
    { :electrolyzerRequest :targetLoad "PEM_electrolyzer_train_2" . },
    { 16 math:notGreaterThan 16 . }.

{ :dispatchPlan :dispatchMW 16 . }
  pe:fact "harborsmr.n3".

{ :dispatchPlan :forLoad "PEM_electrolyzer_train_2" . }
  pe:fact "harborsmr.n3".

{ :electrolyzerRequest :targetLoad "PEM_electrolyzer_train_2" . }
  pe:fact "harborsmr.n3".

{ 16 math:notGreaterThan 16 . }
  pe:builtin math:notGreaterThan.

{ :case :checkC8 :Passed . }
  pe:rule 8;
  pe:uses
    { :policy odrl:prohibition _:b3 . },
    { _:b3 odrl:action odrl:distribute . },
    { _:b3 odrl:target <https://example.org/insight/harborsmr> . },
    { _:b3 odrl:constraint _:b4 . },
    { _:b4 odrl:leftOperand odrl:purpose . },
    { _:b4 odrl:operator odrl:eq . },
    { _:b4 odrl:rightOperand "market_resale" . }.

{ :policy odrl:prohibition _:b3 . }
  pe:fact "harborsmr.n3".

{ _:b3 odrl:action odrl:distribute . }
  pe:fact "harborsmr.n3".

{ _:b3 odrl:target <https://example.org/insight/harborsmr> . }
  pe:fact "harborsmr.n3".

{ _:b3 odrl:constraint _:b4 . }
  pe:fact "harborsmr.n3".

{ _:b4 odrl:leftOperand odrl:purpose . }
  pe:fact "harborsmr.n3".

{ _:b4 odrl:operator odrl:eq . }
  pe:fact "harborsmr.n3".

{ _:b4 odrl:rightOperand "market_resale" . }
  pe:fact "harborsmr.n3".

{ :case :decision :Permit . }
  pe:rule 11;
  pe:uses
    { :case :checkC1 :Passed . },
    { :case :checkC2 :Passed . },
    { :case :checkC3 :Passed . },
    { :case :checkC4 :Passed . },
    { :case :checkC5 :Passed . },
    { :case :checkC6 :Passed . },
    { :case :checkC7 :Passed . },
    { :case :checkC8 :Passed . },
    { :case :checkC9 :Passed . },
    { :case :checkC10 :Passed . }.

{ :decision :target <https://example.org/insight/harborsmr> . }
  pe:rule 11;
  pe:uses
    { :case :checkC1 :Passed . },
    { :case :checkC2 :Passed . },
    { :case :checkC3 :Passed . },
    { :case :checkC4 :Passed . },
    { :case :checkC5 :Passed . },
    { :case :checkC6 :Passed . },
    { :case :checkC7 :Passed . },
    { :case :checkC8 :Passed . },
    { :case :checkC9 :Passed . },
    { :case :checkC10 :Passed . }.

{ :decision :outcome "Allowed" . }
  pe:rule 11;
  pe:uses
    { :case :checkC1 :Passed . },
    { :case :checkC2 :Passed . },
    { :case :checkC3 :Passed . },
    { :case :checkC4 :Passed . },
    { :case :checkC5 :Passed . },
    { :case :checkC6 :Passed . },
    { :case :checkC7 :Passed . },
    { :case :checkC8 :Passed . },
    { :case :checkC9 :Passed . },
    { :case :checkC10 :Passed . }.

{ :out log:outputString "HarborSMR — bounded flexible-export insight for port electrolysis\n\n## Answer\nPERMIT\nThe port hydrogen hub may use the SMR insight to run PEM electrolyzer train 2 at 16 MW from 14:00 to 18:00.\n\n## Reason Why\nThe operator shares only a narrow, expiring insight that a temporary 18 MW flexible-export window is available. The request is for electrolysis dispatch only, the requested 16 MW fits inside the permitted window, safety margins are above threshold, no outage blocks the window, and the policy forbids redistribution for market resale. Raw reactor telemetry stays local.\n\n## Check\nC1  OK - reserve margin exceeds the dispatch threshold\nC2  OK - cooling margin exceeds the dispatch threshold\nC3  OK - no planned outage blocks the window\nC4  OK - requested MW fits within the export window\nC5  OK - serialized insight omits sensitive telemetry terms\nC6  OK - aggregate excludes core temperature, rod position, neutron flux, and operator IDs\nC7  OK - policy allows use for electrolysis dispatch before expiry\nC8  OK - policy prohibits redistribution for market resale\nC9  OK - scope is explicit: device, event, start, and expiry\nC10 OK - dispatch plan matches the requested load and power\n" . }
  pe:rule 12;
  pe:uses { :case :decision :Permit . }.
