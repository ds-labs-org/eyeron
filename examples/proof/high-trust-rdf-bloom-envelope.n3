{ 0.5988792348 math:greaterThan 0 . }
  pe:builtin math:greaterThan.

{ 0.5988792349 math:lessThan 1 . }
  pe:builtin math:lessThan.

{ :artifact :fpRateLower 0.0016708059567271017 . }
  pe:rule 5;
  pe:binding
    [ pe:var "eHi"; pe:value 0.5988792349 ],
    [ pe:var "eLo"; pe:value 0.5988792348 ],
    [ pe:var "fpHi"; pe:value 0.0016708059596428394 ],
    [ pe:var "fpLo"; pe:value 0.0016708059567271017 ],
    [ pe:var "k"; pe:value 7 ],
    [ pe:var "oneMinusHi"; pe:value 0.40112076519999995 ],
    [ pe:var "oneMinusLo"; pe:value 0.40112076510000005 ];
  pe:uses
    { :artifact :expIntervalCertificate :CertifiedDecimalInterval . },
    { :artifact :hashFunctions 7 . },
    { :artifact :expMinusLambdaLower 0.5988792348 . },
    { :artifact :expMinusLambdaUpper 0.5988792349 . },
    { (1.0 0.5988792349) math:difference 0.40112076510000005 . },
    { (1.0 0.5988792348) math:difference 0.40112076519999995 . },
    { (0.40112076510000005 7) math:exponentiation 0.0016708059567271017 . },
    { (0.40112076519999995 7) math:exponentiation 0.0016708059596428394 . }.

