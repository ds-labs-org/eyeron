{ :artifact :withinFpRateBudget true . }
  pe:rule 6;
  pe:binding
    [ pe:var "budget"; pe:value 0.002 ],
    [ pe:var "fpHi"; pe:value 0.0016708059596428394 ];
  pe:uses
    { :artifact :fpRateUpper 0.0016708059596428394 . },
    { :artifact :fpRateBudget 0.002 . },
    { 0.0016708059596428394 math:greaterThan 0 . },
    { 0.0016708059596428394 math:lessThan 0.002 . }.

{ 0.0016708059596428394 math:greaterThan 0 . }
  pe:builtin math:greaterThan.

{ 0.0016708059596428394 math:lessThan 0.002 . }
  pe:builtin math:lessThan.

{ :artifact :expectedExtraExactLookupsUpper 83.54029798214196 . }
  pe:rule 7;
  pe:binding
    [ pe:var "extraHi"; pe:value 83.54029798214196 ],
    [ pe:var "fpHi"; pe:value 0.0016708059596428394 ],
    [ pe:var "q"; pe:value 50000 ];
  pe:uses
    { :artifact :negativeLookupsPerBatch 50000 . },
    { :artifact :fpRateUpper 0.0016708059596428394 . },
    { (50000 0.0016708059596428394) math:product 83.54029798214196 . }.

{ (50000 0.0016708059596428394) math:product 83.54029798214196 . }
  pe:builtin math:product.

{ :artifact :withinExactLookupBudget true . }
  pe:rule 8;
  pe:binding
    [ pe:var "budget"; pe:value 100.0 ],
    [ pe:var "extraHi"; pe:value 83.54029798214196 ];
  pe:uses
    { :artifact :expectedExtraExactLookupsUpper 83.54029798214196 . },
    { :artifact :extraExactLookupsBudget 100.0 . },
    { 83.54029798214196 math:greaterThan 0 . },
    { 83.54029798214196 math:lessThan 100.0 . }.

