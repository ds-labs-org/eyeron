@prefix : <http://example.org/high-trust-rdf#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix pe: <https://eyereasoner.github.io/pe#> .

:artifact :parameterSanity true .
:artifact :indexAgreement true .
:artifact :tripleCount 1200 .
:artifact :lambda 0.5126953125 .
:artifact :expIntervalCertificate :CertifiedDecimalInterval .
:artifact :fpRateLower 0.0016708059567271017 .
:artifact :fpRateUpper 0.0016708059596428394 .
:artifact :withinFpRateBudget true .
:artifact :expectedExtraExactLookupsUpper 83.54029798214196 .
:artifact :withinExactLookupBudget true .
:artifact :deploymentDecision :AcceptForHighTrustUse .

{ :artifact :parameterSanity true . }
  pe:rule 1;
  pe:binding
    [ pe:var "e"; pe:value 100.0 ],
    [ pe:var "k"; pe:value 7 ],
    [ pe:var "m"; pe:value 16384 ],
    [ pe:var "n"; pe:value 1200 ],
    [ pe:var "q"; pe:value 50000 ],
    [ pe:var "r"; pe:value 0.002 ],
    [ pe:var "s"; pe:value 1200 ];
  pe:uses
    { :artifact :canonicalTripleCount 1200 . },
    { :artifact :spoIndexTripleCount 1200 . },
    { :artifact :bloomBits 16384 . },
    { :artifact :hashFunctions 7 . },
    { :artifact :negativeLookupsPerBatch 50000 . },
    { :artifact :fpRateBudget 0.002 . },
    { :artifact :extraExactLookupsBudget 100.0 . },
    { 1200 math:greaterThan 0 . },
    { 1200 math:greaterThan 0 . },
    { 16384 math:greaterThan 0 . },
    { 7 math:greaterThan 0 . },
    { 50000 math:greaterThan 0 . },
    { 0.002 math:greaterThan 0 . },
    { 100.0 math:greaterThan 0 . }.

{ :artifact :canonicalTripleCount 1200 . }
  pe:fact "high-trust-rdf-bloom-envelope.n3".

{ :artifact :spoIndexTripleCount 1200 . }
  pe:fact "high-trust-rdf-bloom-envelope.n3".

{ :artifact :bloomBits 16384 . }
  pe:fact "high-trust-rdf-bloom-envelope.n3".

{ :artifact :hashFunctions 7 . }
  pe:fact "high-trust-rdf-bloom-envelope.n3".

{ :artifact :negativeLookupsPerBatch 50000 . }
  pe:fact "high-trust-rdf-bloom-envelope.n3".

{ :artifact :fpRateBudget 0.002 . }
  pe:fact "high-trust-rdf-bloom-envelope.n3".

{ :artifact :extraExactLookupsBudget 100.0 . }
  pe:fact "high-trust-rdf-bloom-envelope.n3".

{ 1200 math:greaterThan 0 . }
  pe:builtin math:greaterThan.

{ 16384 math:greaterThan 0 . }
  pe:builtin math:greaterThan.

{ 7 math:greaterThan 0 . }
  pe:builtin math:greaterThan.

{ 50000 math:greaterThan 0 . }
  pe:builtin math:greaterThan.

{ 0.002 math:greaterThan 0 . }
  pe:builtin math:greaterThan.

{ 100.0 math:greaterThan 0 . }
  pe:builtin math:greaterThan.

{ :artifact :indexAgreement true . }
  pe:rule 2;
  pe:binding [ pe:var "n"; pe:value 1200 ];
  pe:uses
    { :artifact :canonicalTripleCount 1200 . },
    { :artifact :spoIndexTripleCount 1200 . }.

{ :artifact :tripleCount 1200 . }
  pe:rule 2;
  pe:binding [ pe:var "n"; pe:value 1200 ];
  pe:uses
    { :artifact :canonicalTripleCount 1200 . },
    { :artifact :spoIndexTripleCount 1200 . }.

{ :artifact :lambda 0.5126953125 . }
  pe:rule 3;
  pe:binding
    [ pe:var "k"; pe:value 7 ],
    [ pe:var "kn"; pe:value 8400 ],
    [ pe:var "lambda"; pe:value 0.5126953125 ],
    [ pe:var "m"; pe:value 16384 ],
    [ pe:var "n"; pe:value 1200 ];
  pe:uses
    { :artifact :parameterSanity true . },
    { :artifact :tripleCount 1200 . },
    { :artifact :hashFunctions 7 . },
    { :artifact :bloomBits 16384 . },
    { (7 1200) math:product 8400 . },
    { (8400 16384) math:quotient 0.5126953125 . }.

{ (7 1200) math:product 8400 . }
  pe:builtin math:product.

{ (8400 16384) math:quotient 0.5126953125 . }
  pe:builtin math:quotient.

{ :artifact :expIntervalCertificate :CertifiedDecimalInterval . }
  pe:rule 4;
  pe:binding
    [ pe:var "hi"; pe:value 0.5988792349 ],
    [ pe:var "lambda"; pe:value 0.5126953125 ],
    [ pe:var "lo"; pe:value 0.5988792348 ];
  pe:uses
    { :artifact :lambda 0.5126953125 . },
    { :artifact :certifiedLambda 0.5126953125 . },
    { :artifact :expMinusLambdaLower 0.5988792348 . },
    { :artifact :expMinusLambdaUpper 0.5988792349 . },
    { 0.5126953125 math:greaterThan 0 . },
    { 0.5988792348 math:lessThan 0.5988792349 . },
    { 0.5988792348 math:greaterThan 0 . },
    { 0.5988792349 math:lessThan 1 . }.

{ :artifact :certifiedLambda 0.5126953125 . }
  pe:fact "high-trust-rdf-bloom-envelope.n3".

{ :artifact :expMinusLambdaLower 0.5988792348 . }
  pe:fact "high-trust-rdf-bloom-envelope.n3".

{ :artifact :expMinusLambdaUpper 0.5988792349 . }
  pe:fact "high-trust-rdf-bloom-envelope.n3".

