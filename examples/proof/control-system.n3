    [ pe:var "Dist"; pe:value 35766 ],
    [ pe:var "Err"; pe:value 5 ],
    [ pe:var "FBDiff"; pe:value -2.92 ],
    [ pe:var "FBFactor"; pe:value 1.46 ],
    [ pe:var "FBProp"; pe:value "29"^^xsd:decimal ],
    [ pe:var "FFComp"; pe:value 4.553470372213121 ],
    [ pe:var "FFProp"; pe:value 43.82693235899588 ],
