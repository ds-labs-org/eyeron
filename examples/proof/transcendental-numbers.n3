    { :i :kind :Algebraic . },
    { :i :kind :NotZeroOrOne . },
    { :i :kind :Algebraic . },
    { :i :kind :NonRational . }.

{ :pow_i_i :powBase :i . }
  pe:fact "transcendental-numbers.n3".

{ :pow_i_i :powExp :i . }
  pe:fact "transcendental-numbers.n3".

{ :i :kind :Algebraic . }
  pe:fact "transcendental-numbers.n3".

{ :i :kind :NotZeroOrOne . }
  pe:fact "transcendental-numbers.n3".

{ :i :kind :NonRational . }
  pe:fact "transcendental-numbers.n3".

{ :pow_i_i :provedBy :GelfondSchneider . }
  pe:rule 2;
  pe:binding
    [ pe:var "A"; pe:value :i ],
    [ pe:var "B"; pe:value :i ],
    [ pe:var "X"; pe:value :pow_i_i ];
  pe:uses
    { :pow_i_i :powBase :i . },
    { :pow_i_i :powExp :i . },
    { :i :kind :Algebraic . },
    { :i :kind :NotZeroOrOne . },
    { :i :kind :Algebraic . },
    { :i :kind :NonRational . }.

{ :liouvilleL :kind :NotStraightedgeCompassConstructible . }
  pe:rule 5;
  pe:binding [ pe:var "X"; pe:value :liouvilleL ];
  pe:uses { :liouvilleL :kind :Transcendental . }.

{ :liouvilleL :kind :Transcendental . }
  pe:fact "transcendental-numbers.n3".

{ :pow_e_pi :kind :Transcendental . }
  pe:rule 3;
  pe:binding
    [ pe:var "X"; pe:value :pow_e_pi ],
    [ pe:var "Y"; pe:value :pow_minus1_minusI ];
  pe:uses
    { :pow_e_pi :sameAs :pow_minus1_minusI . },
    { :pow_minus1_minusI :kind :Transcendental . }.

{ :pow_e_pi :sameAs :pow_minus1_minusI . }
  pe:fact "transcendental-numbers.n3".

{ :pow_e_pi :provedBy :GelfondSchneider . }
  pe:rule 4;
  pe:binding
    [ pe:var "T"; pe:value :GelfondSchneider ],
    [ pe:var "X"; pe:value :pow_e_pi ],
    [ pe:var "Y"; pe:value :pow_minus1_minusI ];
  pe:uses
    { :pow_e_pi :sameAs :pow_minus1_minusI . },
    { :pow_minus1_minusI :provedBy :GelfondSchneider . }.

{ :exp_minus_pi_over_2 :kind :Transcendental . }
  pe:rule 3;
  pe:binding
    [ pe:var "X"; pe:value :exp_minus_pi_over_2 ],
    [ pe:var "Y"; pe:value :pow_i_i ];
  pe:uses
    { :exp_minus_pi_over_2 :sameAs :pow_i_i . },
    { :pow_i_i :kind :Transcendental . }.

{ :exp_minus_pi_over_2 :sameAs :pow_i_i . }
  pe:fact "transcendental-numbers.n3".

{ :exp_minus_pi_over_2 :provedBy :GelfondSchneider . }
  pe:rule 4;
  pe:binding
    [ pe:var "T"; pe:value :GelfondSchneider ],
    [ pe:var "X"; pe:value :exp_minus_pi_over_2 ],
    [ pe:var "Y"; pe:value :pow_i_i ];
  pe:uses
    { :exp_minus_pi_over_2 :sameAs :pow_i_i . },
    { :pow_i_i :provedBy :GelfondSchneider . }.

