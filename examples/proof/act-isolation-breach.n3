_:b13_3c493603e434294d :variable :BreachBit .
:case :checkC17 :Passed .
:out log:outputString "ACT isolation-breach token — broad constructor-theory coverage case\n\n## Answer\nYES for the classical isolation-breach token.\nNO for universal cloning and unrestricted fan-out of the quantum provenance seal.\n\n## Reason Why\nThe isolation-breach token is treated as an abstract information variable carried by unlike classical media: a door beacon, a containment PLC, a nurse pager, and an incident board. Because those substrates are information media for the same variable, the token can be prepared, permuted, reversed, cloned locally, copied across media, measured into an output record, and composed into serial and parallel task networks. By contrast, the specimen seal is treated as a superinformation medium, so cloning all of its states is impossible and unrestricted parallel fan-out is blocked.\n\n## Check\nC1  OK - the door beacon is an information medium\nC2  OK - the containment PLC is an information medium\nC3  OK - the nurse pager is an information medium\nC4  OK - the incident board is an information medium\nC5  OK - the door beacon distinguishes the breach bit\nC6  OK - the breach state can be prepared on the nurse pager\nC7  OK - permutation from safe to breach is possible on the door beacon\nC8  OK - the door beacon supports reversible permutation\nC9  OK - local cloning of the breach bit is possible on the containment PLC\nC10 OK - the breach bit can be copied from door beacon to containment PLC\nC11 OK - the breach bit can be copied from containment PLC to nurse pager\nC12 OK - the breach bit can be measured from nurse pager into the incident board\nC13 OK - a serial network from door beacon via containment PLC to incident board is possible\nC14 OK - a parallel network from containment PLC to nurse pager and incident board is possible\nC15 OK - cloning all states of the specimen seal is an impossible task\nC16 OK - the specimen seal cannot be universally cloned\nC17 OK - the specimen seal cannot support unrestricted parallel fan-out\n" .

{ :case :checkC1 :Passed . }
  pe:rule 9;
  pe:uses { :doorBeacon a :InformationMedium . }.

{ :doorBeacon a :InformationMedium . }
  pe:fact "act-isolation-breach.n3".

{ :doorBeacon a :ComputationMedium . }
  pe:rule 1;
  pe:binding
    [ pe:var "M"; pe:value :doorBeacon ],
    [ pe:var "O"; pe:value :BreachRed ],
    [ pe:var "V"; pe:value :BreachBit ],
    [ pe:var "Z"; pe:value :SafeGreen ];
  pe:uses
    { :doorBeacon a :InformationMedium . },
    { :doorBeacon :encodes :BreachBit . },
    { :doorBeacon :zeroState :SafeGreen . },
    { :doorBeacon :oneState :BreachRed . }.

{ :doorBeacon :encodes :BreachBit . }
  pe:fact "act-isolation-breach.n3".

{ :doorBeacon :zeroState :SafeGreen . }
  pe:fact "act-isolation-breach.n3".

{ :doorBeacon :oneState :BreachRed . }
  pe:fact "act-isolation-breach.n3".

{ :doorBeacon :distinguishes :BreachBit . }
  pe:rule 1;
  pe:binding
    [ pe:var "M"; pe:value :doorBeacon ],
    [ pe:var "O"; pe:value :BreachRed ],
    [ pe:var "V"; pe:value :BreachBit ],
    [ pe:var "Z"; pe:value :SafeGreen ];
  pe:uses
    { :doorBeacon a :InformationMedium . },
    { :doorBeacon :encodes :BreachBit . },
    { :doorBeacon :zeroState :SafeGreen . },
    { :doorBeacon :oneState :BreachRed . }.

