{ :pow_2_sqrt2 :inFamily :GelfondSchneiderNumbers . }
  pe:rule 5;
  pe:binding
    [ pe:var "A"; pe:value :2 ],
    [ pe:var "B"; pe:value :sqrt2 ],
    [ pe:var "X"; pe:value :pow_2_sqrt2 ];
  pe:uses
    { :pow_2_sqrt2 :powBase :2 . },
    { :pow_2_sqrt2 :powExp :sqrt2 . },
    { :2 :kind :Algebraic . },
    { :2 :kind :NotZeroOrOne . },
    { :sqrt2 :kind :Algebraic . },
    { :sqrt2 :kind :NonRational . }.

{ :pow_2_sqrt2 :powBase :2 . }
  pe:fact "transcendental-names-and-families.n3".

{ :pow_2_sqrt2 :powExp :sqrt2 . }
  pe:fact "transcendental-names-and-families.n3".

{ :2 :kind :Algebraic . }
  pe:fact "transcendental-names-and-families.n3".

{ :2 :kind :NotZeroOrOne . }
  pe:fact "transcendental-names-and-families.n3".

{ :sqrt2 :kind :Algebraic . }
  pe:fact "transcendental-names-and-families.n3".

{ :sqrt2 :kind :NonRational . }
  pe:fact "transcendental-names-and-families.n3".

{ :pow_2_sqrt2 :provedBy :GelfondSchneider . }
  pe:rule 5;
  pe:binding
    [ pe:var "A"; pe:value :2 ],
    [ pe:var "B"; pe:value :sqrt2 ],
    [ pe:var "X"; pe:value :pow_2_sqrt2 ];
  pe:uses
    { :pow_2_sqrt2 :powBase :2 . },
    { :pow_2_sqrt2 :powExp :sqrt2 . },
    { :2 :kind :Algebraic . },
    { :2 :kind :NotZeroOrOne . },
    { :sqrt2 :kind :Algebraic . },
    { :sqrt2 :kind :NonRational . }.

