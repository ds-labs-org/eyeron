{ :chaitinsOmega :provedBy :NoncomputableImpliesTranscendental . }
  pe:rule 3;
  pe:binding [ pe:var "X"; pe:value :chaitinsOmega ];
  pe:uses { :chaitinsOmega :tag :NonComputable . }.

