{ :exp_sqrt2 :inFamily :LWExpNumbers . }
  pe:rule 4;
  pe:binding
    [ pe:var "A"; pe:value :sqrt2 ],
    [ pe:var "X"; pe:value :exp_sqrt2 ];
  pe:uses
    { :exp_sqrt2 :expArg :sqrt2 . },
    { :sqrt2 :kind :Algebraic . },
    { :sqrt2 :kind :NonZero . }.

{ :exp_sqrt2 :expArg :sqrt2 . }
  pe:fact "transcendental-names-and-families.n3".

{ :sqrt2 :kind :NonZero . }
  pe:fact "transcendental-names-and-families.n3".

