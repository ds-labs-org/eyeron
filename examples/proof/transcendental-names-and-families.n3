{ :e :inFamily :AllTranscendentals . }
  pe:rule 8;
  pe:binding [ pe:var "X"; pe:value :e ];
  pe:uses { :e :kind :Transcendental . }.

{ :e :kind :Transcendental . }
  pe:fact "transcendental-names-and-families.n3".

