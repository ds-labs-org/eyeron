{ :liouvillesConstant :inFamily :AllTranscendentals . }
  pe:rule 1;
  pe:binding
    [ pe:var "F"; pe:value :LiouvilleNumbers ],
    [ pe:var "G"; pe:value :AllTranscendentals ],
    [ pe:var "X"; pe:value :liouvillesConstant ];
  pe:uses
    { :liouvillesConstant :inFamily :LiouvilleNumbers . },
    { :LiouvilleNumbers :subFamilyOf :AllTranscendentals . }.

{ :liouvillesConstant :inFamily :LiouvilleNumbers . }
  pe:fact "transcendental-names-and-families.n3".

{ :LiouvilleNumbers :subFamilyOf :AllTranscendentals . }
  pe:fact "transcendental-names-and-families.n3".

