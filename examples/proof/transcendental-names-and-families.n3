{ :gelfondsConstant :inFamily :GelfondSchneiderNumbers . }
  pe:rule 6;
  pe:binding
    [ pe:var "F"; pe:value :GelfondSchneiderNumbers ],
    [ pe:var "X"; pe:value :gelfondsConstant ],
    [ pe:var "Y"; pe:value :pow_minus1_minusi ];
  pe:uses
    { :gelfondsConstant :sameAs :pow_minus1_minusi . },
    { :pow_minus1_minusi :inFamily :GelfondSchneiderNumbers . }.

{ :gelfondsConstant :sameAs :pow_minus1_minusi . }
  pe:fact "transcendental-names-and-families.n3".

{ :gelfondsConstant :provedBy :GelfondSchneider . }
  pe:rule 7;
  pe:binding
    [ pe:var "T"; pe:value :GelfondSchneider ],
    [ pe:var "X"; pe:value :gelfondsConstant ],
    [ pe:var "Y"; pe:value :pow_minus1_minusi ];
  pe:uses
    { :gelfondsConstant :sameAs :pow_minus1_minusi . },
    { :pow_minus1_minusi :provedBy :GelfondSchneider . }.

{ :chaitinsOmega :inFamily :AlgorithmicRandomNumbers . }
  pe:rule 3;
  pe:binding [ pe:var "X"; pe:value :chaitinsOmega ];
