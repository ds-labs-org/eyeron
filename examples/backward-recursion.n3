# N3 example: backward-recursion.
# Recursive ancestor relation defined via N3 backward chaining (<=), over
# a three-generation parent chain (:a -> :b -> :c -> :d).

@prefix : <urn:example#>.

:a :parent :b.
:b :parent :c.
:c :parent :d.

{?x :ancestor ?y} <= {?x :parent ?y}.
{?x :ancestor ?z} <= {?x :parent ?y. ?y :ancestor ?z}.

{:a :ancestor ?who} => {:a :reaches ?who}.
